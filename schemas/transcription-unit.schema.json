{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-relato.local/schemas/transcription-unit.schema.json",
  "title": "TranscriptionUnit",
  "type": "object",
  "required": [
    "id",
    "manuscript_id",
    "source_id",
    "text",
    "layer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tx:"
    },
    "manuscript_id": {
      "type": "string",
      "pattern": "^ms:ga:"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src:"
    },
    "image_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^image:"
    },
    "passage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^passage:"
      },
      "uniqueItems": true
    },
    "layer": {
      "enum": [
        "raw",
        "diplomatic",
        "normalized"
      ]
    },
    "format": {
      "enum": [
        "plain",
        "tei",
        "xml",
        "html",
        "other"
      ]
    },
    "text": {
      "type": "string"
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
