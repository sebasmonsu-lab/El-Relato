{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-relato.local/schemas/checksum-manifest.schema.json",
  "title": "ChecksumManifest",
  "type": "object",
  "required": [
    "generated_at",
    "algorithm",
    "files"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
