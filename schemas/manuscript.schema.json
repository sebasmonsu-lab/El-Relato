{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-relato.local/schemas/manuscript.schema.json",
  "title": "Manuscript",
  "type": "object",
  "required": [
    "id",
    "ga_id",
    "label",
    "gospels",
    "dating",
    "primary_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ms:ga:"
    },
    "ga_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "alternate_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "gospels": {
      "type": "array",
      "items": {
        "enum": [
          "Matthew",
          "Mark",
          "Luke",
          "John"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dating": {
      "type": "object",
      "required": [
        "display"
      ],
      "properties": {
        "display": {
          "type": "string"
        },
        "not_before": {
          "type": [
            "integer",
            "null"
          ]
        },
        "not_after": {
          "type": [
            "integer",
            "null"
          ]
        },
        "method_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "default": "Greek"
    },
    "institution": {
      "type": [
        "string",
        "null"
      ]
    },
    "shelfmark": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_source": {
      "type": "string",
      "format": "uri"
    },
    "catalog_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "content_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "facsimile_status": {
      "enum": [
        "not_checked",
        "unavailable",
        "registered",
        "partial",
        "mirrored"
      ]
    },
    "transcription_status": {
      "enum": [
        "not_checked",
        "unavailable",
        "registered",
        "partial",
        "mirrored"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}