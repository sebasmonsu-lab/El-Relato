{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-relato.local/schemas/edition-apparatus-unit.schema.json",
  "title": "EditionApparatusUnit",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "book",
    "chapter",
    "verse",
    "ordinal",
    "raw_note",
    "readings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^edition-apparatus:sblgnt:"
    },
    "source_id": {
      "const": "src:sblgnt:faithlife"
    },
    "book": {
      "enum": [
        "Matthew",
        "Mark",
        "Luke",
        "John"
      ]
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "verse": {
      "type": "integer",
      "minimum": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "location_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_note": {
      "type": "string",
      "minLength": 1
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "raw_segment",
          "text",
          "edition_sigla"
        ],
        "properties": {
          "raw_segment": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "edition_sigla": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "parse_status": {
      "enum": [
        "parsed",
        "partial",
        "raw-only"
      ]
    }
  },
  "additionalProperties": false
}
