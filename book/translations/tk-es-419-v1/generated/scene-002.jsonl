{"unit_id":"unit:0023","text":"Libro de la genealogía de Jesucristo"}
{"unit_id":"unit:0024","text":"Y él mismo era Jesús, al comenzar, de unos treinta años,"}
{"unit_id":"unit:0025","text":"hijo de David"}
{"unit_id":"unit:0026","text":"hijo de Abraham."}
{"unit_id":"unit:0027","text":"siendo hijo, según se suponía,"}
{"unit_id":"unit:0028","text":"el esposo de María, de quien nació Jesús, el llamado Cristo."}
{"unit_id":"unit:0029","text":"José, de Elí"}
{"unit_id":"unit:0030","text":"y Jacob engendró a José"}
{"unit_id":"unit:0031","text":"de Matat"}
{"unit_id":"unit:0032","text":"y Eleazar engendró a Matán,"}
{"unit_id":"unit:0033","text":"de Leví"}
{"unit_id":"unit:0034","text":"de Melquí"}
{"unit_id":"unit:0035","text":"de Jannái"}
{"unit_id":"unit:0036","text":"de José"}
{"unit_id":"unit:0037","text":"de Matatías"}
{"unit_id":"unit:0038","text":"de Amós"}
{"unit_id":"unit:0039","text":"de Nahúm"}
{"unit_id":"unit:0040","text":"de Esli"}
