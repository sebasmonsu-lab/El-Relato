{"unit_id":"unit:0043","text":"de Matatías"}
{"unit_id":"unit:0044","text":"de Semeín"}
{"unit_id":"unit:0045","text":"de José"}
{"unit_id":"unit:0046","text":"de Jodá"}
{"unit_id":"unit:0047","text":"de Joanán"}
{"unit_id":"unit:0048","text":"de Resá"}
{"unit_id":"unit:0049","text":"de Zorobabel"}
{"unit_id":"unit:0050","text":"Ahora bien, Salatiel engendró a Zorobabel,"}
{"unit_id":"unit:0051","text":"de Salatiel"}
{"unit_id":"unit:0052","text":"Después de la deportación a Babilonia, Jeconías engendró a Salatiel,"}
{"unit_id":"unit:0053","text":"de Nerí"}
{"unit_id":"unit:0054","text":"de Melquí"}
{"unit_id":"unit:0055","text":"de Addí"}
{"unit_id":"unit:0056","text":"de Cosam"}
{"unit_id":"unit:0057","text":"de Elmadam"}
{"unit_id":"unit:0058","text":"de Er"}
{"unit_id":"unit:0059","text":"de Jesús"}
{"unit_id":"unit:0060","text":"de Eliézer"}
{"unit_id":"unit:0061","text":"de Jorim"}
{"unit_id":"unit:0062","text":"de Matat"}
{"unit_id":"unit:0063","text":"de Leví"}
{"unit_id":"unit:0064","text":"de Simeón"}
{"unit_id":"unit:0065","text":"de Judá"}
{"unit_id":"unit:0066","text":"de José"}
{"unit_id":"unit:0067","text":"de Jonam"}
{"unit_id":"unit:0068","text":"de Eliacim"}
{"unit_id":"unit:0069","text":"Zorobabel engendró a Abiud,"}
{"unit_id":"unit:0070","text":"de Melea"}
{"unit_id":"unit:0071","text":"de Menna"}
{"unit_id":"unit:0072","text":"de Mattata"}
{"unit_id":"unit:0073","text":"de Natán"}
{"unit_id":"unit:0074","text":"David engendró a Salomón de la que había sido esposa de Urías,"}
{"unit_id":"unit:0075","text":"de David"}
{"unit_id":"unit:0076","text":"de Jesé"}
{"unit_id":"unit:0077","text":"de Rut, Obed engendró a Jesé,"}
{"unit_id":"unit:0078","text":"de Jobel"}
{"unit_id":"unit:0079","text":"de Booz"}
{"unit_id":"unit:0080","text":"Salmón engendró a Booz de Rajab,"}
{"unit_id":"unit:0081","text":"Booz engendró a Jobed de"}
{"unit_id":"unit:0082","text":"de Salá"}
{"unit_id":"unit:0083","text":"engendró a Naasón, y Naasón engendró a Salmón,"}
{"unit_id":"unit:0084","text":"de Naasón"}
{"unit_id":"unit:0085","text":"de Aminadab"}
{"unit_id":"unit:0086","text":"Aram engendró a Aminadab, y Aminadab"}
{"unit_id":"unit:0087","text":"de Admín, de"}
{"unit_id":"unit:0088","text":"Arni, de"}
{"unit_id":"unit:0089","text":"Judá engendró a Fares y a Zara de Tamar,"}
{"unit_id":"unit:0090","text":"Fares engendró a Esrom, y Esrom engendró a Aram,"}
{"unit_id":"unit:0091","text":"Esrom, de Fares"}
{"unit_id":"unit:0092","text":"de Judá"}
{"unit_id":"unit:0093","text":"Jacob engendró"}
{"unit_id":"unit:0094","text":"a Judá y a sus hermanos,"}
{"unit_id":"unit:0095","text":"de Jacob"}
{"unit_id":"unit:0096","text":"Isaac engendró a Jacob,"}
{"unit_id":"unit:0097","text":"de Isaac"}
{"unit_id":"unit:0098","text":"Abraham engendró a Isaac,"}
{"unit_id":"unit:0099","text":"de Abraham"}
{"unit_id":"unit:0100","text":"de Taré"}
{"unit_id":"unit:0101","text":"de Najor"}
{"unit_id":"unit:0102","text":"de Serug"}
